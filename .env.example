# Server
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=soulwi_db
POSTGRES_SSL_MODE=disable

# Auth
ACCESS_SECRET=change_me_access_secret
REFRESH_SECRET=change_me_refresh_secret

# Firebase (one of two)
FIREBASE_CREDS_FILE=keys/serviceAccountKey.json
# FIREBASE_CREDS_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=

# Integrations (optional for local dev)
OPENAI_KEY=
TG_BOT_TOKEN=
APPLE_APP_SHARED_SECRET=
APPLE_BUNDLE_ID=com.soulwi.app
APPLE_TEAM_ID=
REDIS_ADDR=

# Runtime controls
CRON_AUTH_KEY=change_me_cron_key
DAILY_MESSAGE_LIMIT_FREE=10
ENABLE_DEV_ROUTES=false
